{
  "name": "cavuno",
  "version": "1.4.0",
  "description": "Manage your Cavuno job board from the command line.",
  "keywords": [
    "ai-agent",
    "cavuno",
    "cli",
    "command-line",
    "hiring",
    "job-board",
    "job-board-api",
    "job-board-automation",
    "job-board-cli",
    "openapi",
    "recruitment",
    "rest-api"
  ],
  "homepage": "https://cavuno.com/docs/cli",
  "bugs": {
    "url": "https://github.com/wollemiahq/cavuno-cli/issues",
    "email": "hi@cavuno.com"
  },
  "license": "MIT",
  "author": {
    "name": "Cavuno",
    "email": "hi@cavuno.com",
    "url": "https://cavuno.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wollemiahq/cavuno-cli.git"
  },
  "bin": {
    "cavuno": "build/index.js"
  },
  "files": [
    "build",
    "manifest.json",
    "LICENSE",
    "TRADEMARKS.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./build/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc && chmod +x ./build/index.js",
    "build:watch": "tsc --watch",
    "clean": "git clean -xdf .turbo build node_modules",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "generate-manifest": "tsx scripts/generate-manifest.ts",
    "assert-publish-target": "node -e \"const p=require('./package.json'); if(p.name!=='cavuno'){throw new Error('Refusing to publish: package.json name is '+p.name+', expected cavuno')}; if(p.private){throw new Error('Refusing to publish: package.json has private:true')}\"",
    "prepublishOnly": "pnpm run assert-publish-target && pnpm run build && pnpm run generate-manifest"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "24.9.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "vitest": "^3.2.6",
    "typescript": "^5.9.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2"
  },
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "pnpm@10.19.0"
}
